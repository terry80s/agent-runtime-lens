{
  "name": "ai-agent-runtime-lens",
  "displayName": "Agent Runtime Lens",
  "description": "Observe Cline and Claude Code activity plus local, Remote-SSH, container, and Pod resource facts.",
  "version": "0.9.0",
  "publisher": "terry80s",
  "icon": "assets/agent-runtime-lens-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terry80s/agent-runtime-lens.git"
  },
  "homepage": "https://github.com/terry80s/agent-runtime-lens#readme",
  "bugs": {
    "url": "https://github.com/terry80s/agent-runtime-lens/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cline",
    "claude",
    "copilot",
    "agent",
    "monitor",
    "diagnostics"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentRuntimeLens.showStatus",
        "title": "Agent Runtime Lens: Show Current Status"
      },
      {
        "command": "agentRuntimeLens.runDiagnosis",
        "title": "Agent Runtime Lens: Is It Stuck?"
      },
      {
        "command": "agentRuntimeLens.openDashboard",
        "title": "Agent Runtime Lens: Open Dashboard"
      },
      {
        "command": "agentRuntimeLens.enableClineIntegration",
        "title": "Agent Runtime Lens: Enable Cline Deep Visibility"
      },
      {
        "command": "agentRuntimeLens.exportDiagnostics",
        "title": "Agent Runtime Lens: Export Diagnostics"
      },
      {
        "command": "agentRuntimeLens.refresh",
        "title": "Agent Runtime Lens: Refresh Now"
      }
    ],
    "configuration": {
      "title": "Agent Runtime Lens",
      "properties": {
        "agentRuntimeLens.refreshIntervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "description": "How often Agent Runtime Lens samples local evidence."
        },
        "agentRuntimeLens.slowThresholdSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "description": "How long an unchanged active state lasts before it is marked slow."
        },
        "agentRuntimeLens.statusBarMode": {
          "type": "string",
          "enum": [
            "minimal",
            "compact",
            "text"
          ],
          "default": "text",
          "description": "Amount of detail shown in the status bar. Minimal hides the four resource values while keeping them in the Agent hover/dashboard."
        },
        "agentRuntimeLens.showReloadButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Reload Window rescue button in the status bar."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none",
    "check": "node --check src/extension.js && node --check src/core.js && node --check src/detectors.js && node --check src/cline-api.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
